<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ink"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="Z"
                android:textColor="@color/lime"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZELVARYN"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APK SIGNING TERMINAL"
                    android:textColor="@color/text_dim"
                    android:textSize="9sp"
                    android:letterSpacing="0.16" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:text="v1.0 · MOBILE"
                android:textColor="@color/lime"
                android:textSize="9sp"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Studio endpoint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 · STUDIO ENDPOINT"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:letterSpacing="0.14" />

            <EditText
                android:id="@+id/etStudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:hint="https://your-zelvaryn-studio"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textColorHint="#5C5478"
                android:textSize="13sp"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveStudio"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="SAVE LINK"
                    android:textColor="@color/text"
                    android:textSize="10sp"
                    android:letterSpacing="0.1" />

                <Button
                    android:id="@+id/btnTestLink"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="TEST LINK"
                    android:textColor="@color/lime"
                    android:textSize="10sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLinkStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Link not tested."
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Signing key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02 · SIGNING KEY"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:letterSpacing="0.14" />

            <Button
                android:id="@+id/btnRefreshKeys"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:text="LOAD KEYSTORES FROM STUDIO"
                android:textColor="@color/text"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

            <Spinner
                android:id="@+id/spinnerKeys"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <EditText
                android:id="@+id/etPassphrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:hint="Keystore passphrase"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textColorHint="#5C5478"
                android:textSize="13sp"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/tvKeyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No keystore selected."
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Artifact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03 · ARTIFACT"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:letterSpacing="0.14" />

            <Button
                android:id="@+id/btnChooseFile"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_ghost"
                android:text="CHOOSE FILE TO SIGN"
                android:textColor="@color/lime"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No artifact selected. Pick an unsigned .apk or a zip of APK contents."
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSign"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_primary"
            android:text="SIGN &amp; DELIVER APK"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/lime"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Idle · waiting for artifact"
            android:textColor="@color/violet"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_log"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:text="› zelvaryn mobile ready\n› signing engine: apk-sig v1 + v2\n"
            android:textColor="#B9AFD6"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#5C5478"
            android:textSize="9sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="Signed artifacts are written to Downloads/Zelvaryn. Keys never leave your studio server."
            android:textColor="#4B4463"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
